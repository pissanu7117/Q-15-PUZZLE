rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{uid} {
      // Public beta leaderboard. These rules restrict ownership and shape, not score authenticity.
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && validScore();
      allow update: if request.auth != null && request.auth.uid == uid
        && validScore()
        && (request.resource.data.moves < resource.data.moves
           || (request.resource.data.moves == resource.data.moves
               && request.resource.data.seconds <= resource.data.seconds));
      allow delete: if false;
      function validScore() {
        return request.resource.data.keys().hasOnly(['name', 'moves', 'seconds', 'updatedAt'])
          && request.resource.data.keys().hasAll(['name', 'moves', 'seconds', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 20
          && request.resource.data.moves is int
          && request.resource.data.moves >= 1
          && request.resource.data.moves <= 100000
          && request.resource.data.seconds is int
          && request.resource.data.seconds >= 0
          && request.resource.data.seconds <= 86400
          && request.resource.data.updatedAt == request.time;
      }
    }
  }
}
